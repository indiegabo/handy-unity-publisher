{
    "productName": "HUP",
    "version": "0.1.0",
    "identifier": "com.indiegabo.handyunitypublisher",
    "mainBinaryName": "HUP",
    "build": {
        "beforeDevCommand": "npm run dev --prefix ../ui",
        "beforeBuildCommand": "npm run build --prefix ../ui",
        "devUrl": "http://127.0.0.1:1420",
        "frontendDist": "../ui/dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "HUP",
                "width": 360,
                "height": 420,
                "resizable": false,
                "visible": false,
                "alwaysOnTop": true,
                "skipTaskbar": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": false,
        "targets": "all",
        "icon": [
            "icons/icon.ico"
        ]
    }
}