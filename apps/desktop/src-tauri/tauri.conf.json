{
    "productName": "HUP",
    "version": "0.1.0",
    "identifier": "com.indiegabo.handyunitypublisher",
    "mainBinaryName": "HUP",
    "build": {
        "frontendDist": "../ui"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "HUP",
