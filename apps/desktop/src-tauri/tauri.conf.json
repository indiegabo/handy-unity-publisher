{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "handy-unity-builder",
    "version": "0.1.0",
    "identifier": "com.indiegabo.handyunitybuilder",
    "build": {
        "frontendDist": "../ui"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "handy-unity-builder",
                "width": 1200,
                "height": 800,
                "resizable": true,
                "visible": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": false,
        "targets": "all"
    }
}