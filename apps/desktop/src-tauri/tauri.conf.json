{
    "productName": "HGP",
    "version": "0.1.0",
    "identifier": "com.indiegabo.handygamespublisher",
    "mainBinaryName": "HGP",
    "build": {
        "beforeDevCommand": "node ../../scripts/sync-app-version.mjs && node ../../scripts/start-desktop-ui-dev-server.mjs",
        "beforeBuildCommand": "node ../../scripts/sync-app-version.mjs && npm run build --prefix ui",
        "devUrl": "http://127.0.0.1:1420",
        "frontendDist": "../ui/dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "Handy Games Publisher",
                "decorations": false,
                "width": 360,
                "height": 420,
                "resizable": false,
                "visible": false,
                "alwaysOnTop": true,
                "skipTaskbar": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": false,
        "targets": "all",
        "icon": [
            "icons/icon.ico"
        ],
        "resources": [
            "localizations/"
        ]
    }
}