                "height": 800,
                "resizable": true,
                "visible": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": false,
        "targets": "all",
        "icon": [
            "icons/icon.ico"
        ]
    }
}