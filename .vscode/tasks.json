{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build desktop ui",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "build",
        "--prefix",
        "apps/desktop/ui"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "build desktop shell",
      "type": "shell",
      "command": "C:/Users/gabao/.cargo/bin/cargo.exe",
      "args": [
        "build",
        "--package",
        "desktop-shell"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "build desktop ui"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ]
    }
  ]
}