{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build desktop shell",
      "type": "shell",
      "command": "C:/Users/gabao/.cargo/bin/cargo.exe",
      "args": [
        "build",
        "--package",
        "desktop-shell"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ]
    }
  ]
}