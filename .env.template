# Copy this file to `.env` before running `docker compose up`.
#
# This template documents the runtime variables used by the local Docker stack.
# Docker Compose reads `.env` automatically from the repository root.
#
# Important:
# - HOST_DATA_DIR must be an absolute host path.
# - The app uses HOST_DATA_DIR to tell the host Docker daemon where workspaces,
#   artifacts, and logs live.
# - The local Compose stack mounts SQLite into a dedicated internal Docker
#   volume, separate from HOST_DATA_DIR, so WAL and SHM sidecars do not spill
#   into the project tree.

# Runtime mode for the local stack.
# Typical values: development, staging, production.
APP_ENV=development

# HTTP port exposed by Docker and used by the app when HTTP_ADDR is empty.
# Change this if port 8080 is already occupied on the host.
APP_PORT=8080

# Optional full bind address for the HTTP server.
# Leave this empty unless you need a custom host/interface binding.
# When set, this overrides APP_PORT inside the app.
HTTP_ADDR=

# Persistent runtime root inside the containers.
# Leave this as /data unless you intentionally want a different container path.
DATA_DIR=/data

# Absolute host directory mounted into DATA_DIR.
# This is the main knob for changing where logs, artifacts, and workspaces live
# on the host machine.
#
# Example:
# HOST_DATA_DIR=/home/your-user/projects/handy-unity-builder/data
HOST_DATA_DIR=/absolute/host/path/to/handy-unity-builder/data

# Declarative pipeline manifests directory inside the server container.
# In the local Compose stack this points at the repository-root `pipelines/`
# folder mounted through `/workspace`.
PIPELINES_DIR=/workspace/pipelines

# Explicit SQLite path inside the container.
# The local Compose stack expects this to stay under the dedicated internal
# database volume mounted at /var/lib/handy-unity-bulder.
#
# Export and import are handled through `hub db export` and `hub db import`.
APP_DB_PATH=/var/lib/handy-unity-bulder/hub.db

# Redis address seen from the application containers.
# In the local stack the service name `redis` is correct.
REDIS_ADDR=redis:6379

# Redis logical database number.
# Keep 0 unless you intentionally separate environments inside one Redis.
REDIS_DB=0

# Structured log verbosity for the application processes.
# Common values: debug, info, warn, error.
LOG_LEVEL=debug

# Personal access token used by the Revolutions pipeline Git credential.
# Keep secrets out of pipeline YAML files. The manifest references this variable
# through `env: REVOLUTIONS_GIT_PAT`.
REVOLUTIONS_GIT_PAT=