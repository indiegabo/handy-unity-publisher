{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "composite": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "vite.config.ts", "vite.e2e.config.ts"]
}
